<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>simple-rest-api</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
    </parent>

    <properties>
        <java.version>17</java.version>
        <rest-assured.version>5.3.2</rest-assured.version>
        <!--
          Overrides the 1.18.30 pinned by spring-boot-dependencies 3.2.0.
          Not required for JDK 23 (see the annotationProcessorPaths note below for the
          actual cause of the build failure) but keeps Lombok current: 1.18.36 added
          JDK 23 support and 1.18.38 adds JDK 24, so this won't need revisiting when
          the toolchain moves forward.
        -->
        <lombok.version>1.18.38</lombok.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.0</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <!-- Version comes from the lombok.version property above. -->
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-path</artifactId>
            <version>${rest-assured.version}</version>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${rest-assured.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!--
                  Declare the annotation processor explicitly.

                  JDK 23 turned OFF implicit annotation processing: javac no longer
                  scans the compile classpath for processors, so Lombok silently never
                  ran and every @Getter/@Setter/@AllArgsConstructor member vanished.
                  The build then failed with ~94 misleading "cannot find symbol" errors
                  and no Lombok diagnostic at all, because nothing had gone wrong from
                  javac's point of view. (JDK 21 only warned; 23 made it the default.)

                  Setting annotationProcessorPaths passes an explicit processor-path to
                  javac, which makes processing explicit and works on every JDK version.
                  The alternative, "proc:full", merely restores the deprecated scan.

                  NOTE: maven-compiler-plugin 3.11.0 (from the Spring Boot parent) does
                  not take versions for these paths from dependencyManagement, so the
                  version has to be named here. 3.12.0+ can infer it.
                -->
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

